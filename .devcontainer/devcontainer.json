{
    "name": "dev-quests",
    "image": "mcr.microsoft.com/devcontainers/base:jammy",
    "runArgs": [
        "--name",
        "dev-quests"
    ],
    "features": {
        "ghcr.io/devcontainers/features/dotnet:2": {},
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/go:1": {},
        "ghcr.io/devcontainers/features/python:1": {},
        "ghcr.io/devcontainers-community/npm-features/typescript:1": {},
        "ghcr.io/devcontainers/features/rust:1": {}
    },
    "mounts": [
        // Claude Code memory & config — same data as the host.
        //
        // Both variables, concatenated, because this file is opened from two
        // kinds of machine now: Windows sets USERPROFILE and not HOME, Linux
        // (the `bench` workstation, ADR 0039) sets HOME and not USERPROFILE, so
        // exactly one half resolves and the other is empty. A shell that sets
        // *both* on Windows — git-bash launching VS Code — would concatenate
        // them into a path that does not exist and fail the mount.
        "source=${localEnv:USERPROFILE}${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "streetsidesoftware.code-spell-checker",
                "DavidAnson.vscode-markdownlint",
                "littlefoxteam.vscode-python-test-adapter",
                "github.vscode-github-actions",
                "cweijan.vscode-mysql-client2",
                "rogalmic.bash-debug",
                "lfm.vscode-makefile-term",
                "EditorConfig.EditorConfig",
                "anthropic.claude-code"
            ]
        }
    },
    "postCreateCommand": "bash ./scripts/install_dependencies.sh"
}
